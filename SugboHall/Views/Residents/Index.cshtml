@model List<HallBook.Models.Resident>
@{
    ViewData["Title"] = "Residents";
    string search = ViewBag.Search as string ?? "";
}

<!-- Page Header Strip -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-extrabold mb-0">Community Residents</h2>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">@Model.Count registered</span>
        </div>
        <p class="text-muted mb-0">Manage community resident directory, contact details, and their hall booking activities.</p>
    </div>
    <a href="/Residents/Create" class="btn btn-gradient-primary px-3 py-2 d-flex align-items-center gap-2">
        <i class="bi bi-person-plus-fill"></i>
        <span>Register New Resident</span>
    </a>
</div>

<!-- Search Bar Card -->
<div class="card-modern p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-7 col-lg-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted ps-3">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" class="form-control border-start-0 ps-1" placeholder="Search by name, email, or phone number..." value="@search" />
                <button class="btn btn-primary px-4 fw-semibold" type="submit">Search</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a href="/Residents" class="btn btn-outline-secondary px-3">
                        <i class="bi bi-x-lg"></i> Clear
                    </a>
                }
            </div>
        </div>
        <div class="col-md-5 col-lg-6 text-md-end text-muted small">
            @if (!string.IsNullOrEmpty(search))
            {
                <span>Showing search results for "<strong>@search</strong>" &bull; </span>
            }
            <span>Total: <strong>@Model.Count</strong> resident profile(s)</span>
        </div>
    </form>
</div>

<!-- Residents Table Card -->
<div class="card-modern overflow-hidden">
    <div class="table-responsive">
        <table class="table-modern">
            <thead>
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Resident Name</th>
                    <th>Contact Info</th>
                    <th>Residential Address</th>
                    <th>Bookings</th>
                    <th class="text-end" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    string initials = $"{r.FirstName[0]}{r.LastName[0]}";
                    <tr>
                        <td class="fw-bold text-muted">
                            <span class="badge bg-light text-dark border px-2 py-1">#@r.ResidentId</span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-circle">@initials</div>
                                <div>
                                    <div class="fw-bold text-dark fs-6">@r.LastName, @r.FirstName</div>
                                    <small class="text-muted"><i class="bi bi-calendar-event me-1"></i>Joined @r.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div>
                                <a href="mailto:@r.Email" class="text-decoration-none text-dark fw-semibold">
                                    <i class="bi bi-envelope text-primary me-1"></i>@r.Email
                                </a>
                            </div>
                            <small class="text-muted">
                                <i class="bi bi-telephone text-success me-1"></i>@r.Phone
                            </small>
                        </td>
                        <td>
                            <span class="text-muted">
                                <i class="bi bi-geo-alt text-danger me-1"></i>@(r.Address ?? "No address registered")
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-bold">
                                @r.BookingCount bookings
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1.5">
                                <a href="/Residents/Edit/@r.ResidentId" class="btn btn-sm btn-outline-primary rounded-pill px-2.5" title="Edit Resident">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <form method="post" asp-action="Delete" asp-route-id="@r.ResidentId" class="d-inline" onsubmit="return confirm('Are you sure you want to delete resident @r.FullName?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-2.5" title="Delete Resident">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x display-5 d-block mb-2 text-secondary"></i>
                            <div class="fw-bold fs-5">No residents found</div>
                            <small class="text-muted">No records match your query. Try resetting your search or add a new resident.</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
