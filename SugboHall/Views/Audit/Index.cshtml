@model List<HallBook.Models.BookingAudit>
@{
    ViewData["Title"] = "System Audit Log";
}

<!-- Page Header Strip -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-extrabold mb-0">System Audit Trail</h2>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">@Model.Count recorded entries</span>
        </div>
        <p class="text-muted mb-0">Immutable change logs triggered automatically by MySQL Trigger: <code>trg_booking_status_audit</code> on table <code>hall_bookings</code>.</p>
    </div>
    <div>
        <a href="/Bookings" class="btn btn-outline-primary px-3 py-2">
            <i class="bi bi-calendar-check me-1"></i> Go to Bookings
        </a>
    </div>
</div>

<!-- Info Alert Callout -->
<div class="card-modern p-3.5 mb-4" style="background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%); border-color: #bbf7d0;">
    <div class="d-flex align-items-center gap-3">
        <div class="avatar-circle" style="width: 40px; height: 40px; background: #10b981; color: #ffffff;">
            <i class="bi bi-shield-check"></i>
        </div>
        <div>
            <span class="fw-bold text-dark">Automated Audit Verification:</span>
            <span class="text-muted small d-block">
                Every status change (Pending &rarr; Confirmed &rarr; Completed / Cancelled) activates <code>AFTER UPDATE ON hall_bookings</code> to write directly into <code>booking_audit</code> without any manual INSERT queries.
            </span>
        </div>
    </div>
</div>

<!-- Audit Log Table Card -->
<div class="card-modern overflow-hidden">
    <div class="table-responsive">
        <table class="table-modern">
            <thead>
                <tr>
                    <th style="width: 80px;">Audit ID</th>
                    <th>Booking Ref</th>
                    <th>Event Details</th>
                    <th>Resident</th>
                    <th>Hall / Venue</th>
                    <th>Action</th>
                    <th>Status Transition</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var actionBadge = a.Action switch
                    {
                        "CONFIRMATION" => "bg-success text-white",
                        "CANCELLATION" => "bg-danger text-white",
                        "COMPLETION" => "bg-info text-white",
                        _ => "bg-secondary text-white"
                    };

                    string initials = "R";
                    if (!string.IsNullOrEmpty(a.ResidentFirstName) && !string.IsNullOrEmpty(a.ResidentLastName))
                    {
                        initials = $"{a.ResidentFirstName[0]}{a.ResidentLastName[0]}";
                    }

                    <tr>
                        <td class="fw-bold text-muted">
                            <span class="badge bg-light text-dark border px-2 py-1">#@a.AuditId</span>
                        </td>
                        <td>
                            <a href="/Bookings/Details/@a.BookingId" class="badge bg-primary-subtle text-primary border border-primary-subtle text-decoration-none px-2.5 py-1 fw-bold">
                                Booking #@a.BookingId
                            </a>
                        </td>
                        <td>
                            <span class="fw-bold text-dark d-block">@a.EventName</span>
                            <small class="text-muted">@a.Details</small>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle" style="width: 32px; height: 32px; font-size: 0.75rem;">@initials</div>
                                <span class="fw-semibold text-dark small">@a.ResidentFullName</span>
                            </div>
                        </td>
                        <td>
                            <span class="fw-semibold text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@a.HallName</span>
                        </td>
                        <td>
                            <span class="badge @actionBadge px-2.5 py-1 fw-bold" style="font-size: 0.75rem;">
                                @a.Action
                            </span>
                        </td>
                        <td>
                            <div class="d-inline-flex align-items-center gap-1.5">
                                <span class="badge bg-secondary-subtle text-dark border px-2 py-1">@(a.OldStatus ?? "None")</span>
                                <i class="bi bi-arrow-right text-muted small"></i>
                                <span class="badge bg-primary-subtle text-primary border px-2 py-1">@a.NewStatus</span>
                            </div>
                        </td>
                        <td>
                            <small class="text-muted d-block"><i class="bi bi-clock me-1"></i>@a.AuditTimestamp.ToString("MMM dd, yyyy")</small>
                            <small class="text-muted fw-semibold">@a.AuditTimestamp.ToString("hh:mm:ss tt")</small>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x display-5 d-block mb-2 text-secondary"></i>
                            <div class="fw-bold fs-5">No audit trail records</div>
                            <small>Logs will automatically generate when booking statuses are updated.</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
