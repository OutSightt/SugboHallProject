@{
    ViewData["Title"] = "Admin login";
    Layout = "_PublicLayout";
}
<section class="login-wrap">
    <div class="login-card">
        <div class="login-badge"><i class="bi bi-shield-lock-fill"></i></div>
        <h1>Admin login</h1>
        <p class="text-muted mb-4">Sign in to manage venues, residents and bookings.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Login" asp-controller="Admin">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <label class="form-label fw-semibold" for="username">Username</label>
            <input class="form-control mb-3" id="username" name="username" autocomplete="username" required autofocus />
            <label class="form-label fw-semibold" for="password">Password</label>
            <input class="form-control mb-4" id="password" name="password" type="password" autocomplete="current-password" required />
            <button class="btn btn-gradient-primary w-100 py-2" type="submit">Sign in</button>
        </form>
        <a class="d-block text-center mt-3 small" href="/">&larr; Back to the welcome page</a>
    </div>
</section>
