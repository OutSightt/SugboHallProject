@model HallBook.Models.BookingDetailViewModel
@{
    ViewData["Title"] = "Reservation #" + Model.Booking.BookingId;
    var b = Model.Booking;
    var statusClass = b.Status switch
    {
        "Pending" => "status-pending",
        "Confirmed" => "status-confirmed",
        "Completed" => "status-completed",
        "Cancelled" => "status-cancelled",
        _ => "bg-secondary text-white"
    };

    string initials = "R";
    if (!string.IsNullOrEmpty(b.ResidentFirstName) && !string.IsNullOrEmpty(b.ResidentLastName))
    {
        initials = $"{b.ResidentFirstName[0]}{b.ResidentLastName[0]}";
    }
}

<!-- Top Header Strip -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <a href="/Bookings" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left"></i> Back to Reservations</a>
        <div class="d-flex align-items-center gap-2 mt-1">
            <h2 class="fw-extrabold mb-0">Booking #@b.BookingId &mdash; @b.EventName</h2>
            <span class="badge-status @statusClass">@b.Status</span>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Ticket Receipt & Actions -->
    <div class="col-lg-7">
        <!-- Ticket Card -->
        <div class="ticket-card mb-4">
            <div class="ticket-header d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-warning text-dark fw-bold mb-1" style="font-size: 0.7rem;">OFFICIAL RESERVATION</span>
                    <h4 class="fw-extrabold mb-0 text-white">@b.EventName</h4>
                    <small class="text-white text-opacity-75"><i class="bi bi-clock me-1"></i>Booked on @b.CreatedAt.ToString("MMMM dd, yyyy &bull; hh:mm tt")</small>
                </div>
                <div class="text-end">
                    <span class="badge bg-white bg-opacity-20 text-white border border-white border-opacity-25 px-3 py-1.5 fs-6">
                        #@b.BookingId
                    </span>
                </div>
            </div>

            <div class="ticket-body">
                <div class="row g-4">
                    <!-- Hall Spec -->
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.75rem;">Venue Information</small>
                        <div class="fw-bold fs-5 text-dark">@b.HallName</div>
                        <div class="text-muted small"><i class="bi bi-geo-alt text-danger me-1"></i>@b.HallLocation</div>
                        <div class="text-muted small mt-1"><i class="bi bi-people me-1"></i>Max capacity: @b.HallCapacity pax</div>
                        <div class="text-muted small"><i class="bi bi-tag me-1"></i>Rate: ₱@b.HallRate.ToString("N2")/hr</div>
                    </div>

                    <!-- Date & Time Slot -->
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.75rem;">Scheduled Schedule</small>
                        <div class="fw-bold fs-5 text-dark"><i class="bi bi-calendar3 text-primary me-1"></i>@b.EventDate.ToString("MMMM dd, yyyy")</div>
                        <div class="text-dark fw-semibold mt-1">
                            <i class="bi bi-clock-history me-1 text-primary"></i>@b.StartTime.ToString(@"hh\:mm") – @b.EndTime.ToString(@"hh\:mm")
                        </div>
                    </div>

                    <!-- Resident Organizer Card -->
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3 d-flex align-items-center gap-3">
                            <div class="avatar-circle" style="width: 48px; height: 48px; font-size: 1.1rem;">@initials</div>
                            <div class="flex-grow-1">
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Resident Organizer</small>
                                <div class="fw-bold text-dark fs-6">@b.ResidentFullName</div>
                                <div class="text-muted small">
                                    <i class="bi bi-envelope me-1"></i>@b.ResidentEmail &bull; <i class="bi bi-telephone ms-2 me-1"></i>@b.ResidentPhone
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Financial Total Box -->
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background-color: #ecfdf5; border: 1px solid #a7f3d0;">
                            <div>
                                <small class="text-uppercase fw-bold text-success" style="font-size: 0.75rem;">Total Computed Rental Charge</small>
                                <div class="text-muted small">Computed via Stored Function: <code>CalculateRentalCharge</code></div>
                            </div>
                            <div class="text-end">
                                <div class="calculated-fee" style="font-size: 2.25rem;">₱@b.TotalCharge.ToString("N2")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Action Transition Buttons -->
                <div class="mt-4 pt-3 border-top">
                    <small class="text-muted text-uppercase fw-bold d-block mb-2" style="font-size: 0.75rem;">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Workflow Actions (Activates MySQL Trigger: <code>trg_booking_status_audit</code>)
                    </small>

                    <div class="d-flex flex-wrap gap-2">
                        @if (b.Status == "Pending")
                        {
                            <form method="post" asp-action="UpdateStatus" asp-route-id="@b.BookingId">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="newStatus" value="Confirmed" />
                                <button type="submit" class="btn btn-success fw-bold px-3 py-2 d-flex align-items-center gap-1.5 shadow-sm">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>Confirm Reservation</span>
                                </button>
                            </form>
                            <form method="post" asp-action="UpdateStatus" asp-route-id="@b.BookingId" onsubmit="return confirm('Cancel this reservation?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="newStatus" value="Cancelled" />
                                <button type="submit" class="btn btn-outline-danger fw-bold px-3 py-2 d-flex align-items-center gap-1.5">
                                    <i class="bi bi-x-circle-fill"></i>
                                    <span>Cancel Booking</span>
                                </button>
                            </form>
                        }
                        else if (b.Status == "Confirmed")
                        {
                            <form method="post" asp-action="UpdateStatus" asp-route-id="@b.BookingId">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="newStatus" value="Completed" />
                                <button type="submit" class="btn btn-info text-white fw-bold px-3 py-2 d-flex align-items-center gap-1.5 shadow-sm">
                                    <i class="bi bi-flag-fill"></i>
                                    <span>Mark as Completed</span>
                                </button>
                            </form>
                            <form method="post" asp-action="UpdateStatus" asp-route-id="@b.BookingId" onsubmit="return confirm('Cancel this reservation?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="newStatus" value="Cancelled" />
                                <button type="submit" class="btn btn-outline-danger fw-bold px-3 py-2 d-flex align-items-center gap-1.5">
                                    <i class="bi bi-x-circle-fill"></i>
                                    <span>Cancel Booking</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-light border mb-0 py-2 px-3 small text-muted">
                                <i class="bi bi-info-circle me-1"></i> This reservation has concluded with status <strong>@b.Status</strong>.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Visual Audit Timeline from Trigger -->
    <div class="col-lg-5">
        <div class="card-modern p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-clock-history text-primary me-2"></i>Audit Trail
                </h5>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1">
                    @Model.Audits.Count logs
                </span>
            </div>

            <p class="text-muted small mb-4">
                These log records are inserted <strong>automatically by the MySQL Trigger</strong> (<code>trg_booking_status_audit</code>) whenever status changes occur.
            </p>

            @if (Model.Audits.Any())
            {
                <div class="timeline">
                    @foreach (var a in Model.Audits)
                    {
                        var dotClass = "dot-" + a.Action;
                        <div class="timeline-item">
                            <div class="timeline-dot @dotClass"></div>
                            <div class="p-3 bg-light rounded-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-dark">@a.Action</span>
                                    <small class="text-muted">@a.AuditTimestamp.ToString("MMM dd &bull; hh:mm tt")</small>
                                </div>
                                <div class="mb-2">
                                    <span class="badge bg-secondary-subtle text-dark border me-1">@a.OldStatus</span>
                                    <i class="bi bi-arrow-right text-muted small"></i>
                                    <span class="badge bg-primary-subtle text-primary border ms-1">@a.NewStatus</span>
                                </div>
                                <small class="text-muted d-block" style="line-height: 1.4;">@a.Details</small>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-journal-x display-6 d-block mb-2 text-secondary"></i>
                    <div class="fw-semibold">No audit logs recorded yet</div>
                    <small>Change the status of this booking above to activate the MySQL Trigger!</small>
                </div>
            }
        </div>
    </div>
</div>
