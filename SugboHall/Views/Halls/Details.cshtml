@model HallBook.Models.HallDetailViewModel
@{
    ViewData["Title"] = Model.Hall.HallName;
    var h = Model.Hall;
    var statusClass = h.Status switch
    {
        "Available" => "status-available",
        "Under Maintenance" => "status-under-maintenance",
        "Closed" => "status-closed",
        _ => "bg-secondary text-white"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <a href="/Halls" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left"></i> Back to Venues</a>
        <h2 class="fw-extrabold mb-0 mt-1">@h.HallName</h2>
        <span class="text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@h.Location</span>
    </div>
    <div class="d-flex gap-2">
        @if (h.Status == "Available")
        {
            <a href="/Bookings/Create?hall_id=@h.HallId" class="btn btn-gradient-primary px-3 py-2">
                <i class="bi bi-calendar-plus-fill me-1"></i> Book This Hall
            </a>
        }
        <a href="/Halls/Edit/@h.HallId" class="btn btn-outline-secondary px-3 py-2">
            <i class="bi bi-pencil-fill me-1"></i> Edit Specs
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Hall Specs Side Column -->
    <div class="col-lg-4">
        <div class="card-modern p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Venue Details</h5>
                <span class="badge-status @statusClass">@h.Status</span>
            </div>

            <div class="calculator-box mb-3 p-3">
                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Hourly Rental Rate</small>
                <div class="calculated-fee" style="font-size: 2.2rem;">₱@h.RatePerHour.ToString("N2")</div>
                <small class="text-muted">per hour duration</small>
            </div>

            <div class="list-group list-group-flush mb-3">
                <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                    <span class="text-muted"><i class="bi bi-people me-2"></i>Max Capacity</span>
                    <span class="fw-bold text-dark">@h.Capacity persons</span>
                </div>
                <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                    <span class="text-muted"><i class="bi bi-geo-alt me-2"></i>Location</span>
                    <span class="fw-semibold text-dark text-end">@h.Location</span>
                </div>
                <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                    <span class="text-muted"><i class="bi bi-calendar-check me-2"></i>Total Bookings</span>
                    <span class="badge bg-primary rounded-pill">@Model.Bookings.Count</span>
                </div>
            </div>

            <div>
                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.75rem;">Amenities & Features</small>
                <p class="text-muted small mb-0" style="line-height: 1.6;">
                    @(h.Description ?? "No description provided for this venue.")
                </p>
            </div>
        </div>
    </div>

    <!-- Reservations Schedule -->
    <div class="col-lg-8">
        <div class="card-modern overflow-hidden">
            <div class="p-3.5 px-4 bg-white border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0"><i class="bi bi-calendar-range text-primary me-2"></i>Scheduled Reservations</h5>
                    <small class="text-muted">All past and upcoming bookings for this specific venue</small>
                </div>
                <span class="badge bg-light text-dark border px-3 py-1">@Model.Bookings.Count event(s)</span>
            </div>

            <div class="table-responsive">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Ref #</th>
                            <th>Event Name</th>
                            <th>Resident</th>
                            <th>Date & Time</th>
                            <th>Charge</th>
                            <th>Status</th>
                            <th class="text-end">View</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Bookings)
                        {
                            var bStatusClass = b.Status switch
                            {
                                "Pending" => "status-pending",
                                "Confirmed" => "status-confirmed",
                                "Completed" => "status-completed",
                                "Cancelled" => "status-cancelled",
                                _ => "bg-secondary text-white"
                            };

                            <tr>
                                <td class="fw-bold text-muted">
                                    <span class="badge bg-light text-dark border px-2 py-1">#@b.BookingId</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark d-block">@b.EventName</span>
                                    <small class="text-muted">ID #@b.BookingId</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@b.ResidentFullName</div>
                                    <small class="text-muted">@b.ResidentPhone</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@b.EventDate.ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted"><i class="bi bi-clock me-1"></i>@b.StartTime.ToString(@"hh\:mm") – @b.EndTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">₱@b.TotalCharge.ToString("N2")</span>
                                </td>
                                <td>
                                    <span class="badge-status @bStatusClass">@b.Status</span>
                                </td>
                                <td class="text-end">
                                    <a href="/Bookings/Details/@b.BookingId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Bookings.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-x display-6 d-block mb-2 text-secondary"></i>
                                    <div class="fw-bold fs-6">No reservations scheduled</div>
                                    <small>This venue currently has no recorded events.</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
