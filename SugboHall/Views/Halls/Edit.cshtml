@model HallBook.Models.Hall
@{
    ViewData["Title"] = "Edit Hall - " + Model.HallName;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a href="/Halls" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left"></i> Back to Venues</a>
                <h2 class="fw-extrabold mb-0 mt-1">Edit Hall Specs</h2>
            </div>
            <span class="badge bg-light text-dark border px-3 py-1">ID #@Model.HallId</span>
        </div>

        <div class="card-modern p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 pb-3 mb-4 border-bottom">
                <div class="avatar-circle" style="width: 48px; height: 48px; font-size: 1.1rem; background: linear-gradient(135deg, #fde68a 0%, #f59e0b 100%); color: #78350f;">
                    <i class="bi bi-pencil-fill"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">Update @Model.HallName</h5>
                    <small class="text-muted">Modify venue rate, capacity, status, or details.</small>
                </div>
            </div>

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="HallId" />
                <div class="row g-3">
                    <div class="col-md-7">
                        <label class="form-label fw-bold small text-muted text-uppercase">Hall Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-building"></i></span>
                            <input asp-for="HallName" class="form-control" required />
                        </div>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-bold small text-muted text-uppercase">Operational Status <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Available">Available</option>
                            <option value="Under Maintenance">Under Maintenance</option>
                            <option value="Closed">Closed</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small text-muted text-uppercase">Location / Floor <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-geo-alt"></i></span>
                            <input asp-for="Location" class="form-control" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted text-uppercase">Capacity (Persons) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-people"></i></span>
                            <input asp-for="Capacity" class="form-control" type="number" min="1" required />
                            <span class="input-group-text bg-light text-muted">pax</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted text-uppercase">Hourly Rate (₱) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">₱</span>
                            <input asp-for="RatePerHour" class="form-control" type="number" step="0.01" min="0.01" required />
                            <span class="input-group-text bg-light text-muted">/ hr</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small text-muted text-uppercase">Venue Features & Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a href="/Halls" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn btn-gradient-primary px-4 py-2">
                        <i class="bi bi-check-circle-fill me-1"></i> Update Hall
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
